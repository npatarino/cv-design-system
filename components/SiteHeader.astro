---
/**
 * SiteHeader — shared ecosystem header (brand, primary nav, theme toggle,
 * socials). Mobile (< 1024px): hamburger + overlay menu. Desktop (≥ 1024px):
 * inline nav with hover/focus dropdowns.
 *
 * Props: `brand`, `links`, `socials`, `mobileMenu`, `themeToggle`, `labels`.
 *
 * `labels` (optional) translates every built-in string. Defaults are the
 * Spanish texts the header has always shipped:
 *   openMenu "Abrir menú" · closeMenu "Cerrar menú" · nav "Principal" ·
 *   home "Inicio" (brand aria-label = `${brand.label} — ${home}`) ·
 *   submenu "Mostrar submenú de {label}" · themeToLight "Activar modo claro" ·
 *   themeToDark "Activar modo oscuro" · themeTitle "Cambiar tema".
 *
 * Slot `actions` (optional): icon actions rendered in the actions zone,
 * before the theme toggle (e.g. a search link). Direct `<a>`/`<button>`
 * children get the toggle's box: icon centred, muted colour, accent on
 * hover, visible focus ring, 32×32 on desktop and a 44×44 touch area
 * below 1024px. Give each one an accessible name (`aria-label`):
 *
 *   <SiteHeader brand={brand} links={links}>
 *     <a slot="actions" href="/buscar" aria-label="Buscar"><SearchIcon /></a>
 *   </SiteHeader>
 *
 * Mobile menu contract: the closed menu is `visibility: hidden` (out of the
 * tab order and the accessibility tree). The toggle keeps `aria-expanded`
 * and its label in sync, Escape closes and returns focus to it, and
 * following a link closes the menu. Without JavaScript the nav renders in
 * flow under the brand instead. With `mobileMenu={false}` there is no
 * hamburger and the nav stays hidden below 1024px, as in 0.8.x.
 */
import SocialIcons from "./SocialIcons.astro";
import ThemeIcons from "./ThemeIcons.astro";
import BrandMark from "./BrandMark.astro";
import type { SocialLink } from "./ecosystem";

export interface NavLink {
  href: string;
  label: string;
  external?: boolean;
  cta?: boolean;
  /** Optional dropdown children. Shown on hover (desktop) or click (mobile). */
  children?: { href: string; label: string }[];
}

export interface BrandConfig {
  href?: string;
  label: string;
  mark?: string;
  emText?: string;
  byline?: string;
  ariaLabel?: string;
  /**
   * Optional theme-aware logo. When present, replaces the textual brand
   * (label/emText/byline) with an <img>. Both variants are rendered and
   * swapped via CSS based on [data-theme] on <html>.
   * - light: shown when theme is light (typically dark-inked artwork).
   * - dark: shown when theme is dark (default; typically light-inked artwork).
   */
  logoSrc?: { light: string; dark: string };
  /** Intrinsic logo height in px. Defaults to 28. */
  logoHeight?: number;
}

/** Every built-in string of the header. All optional; see the defaults below. */
export interface SiteHeaderLabels {
  /** Hamburger aria-label while the menu is closed. */
  openMenu?: string;
  /** Hamburger aria-label while the menu is open. */
  closeMenu?: string;
  /** aria-label of the <nav>. */
  nav?: string;
  /** Suffix of the brand link aria-label (`${brand.label} — ${home}`). */
  home?: string;
  /** aria-label of the mobile submenu toggle; `{label}` is the parent link. */
  submenu?: string;
  /** Theme toggle aria-label while the dark theme is active. */
  themeToLight?: string;
  /** Theme toggle aria-label while the light theme is active. */
  themeToDark?: string;
  /** Theme toggle tooltip. */
  themeTitle?: string;
}

const DEFAULT_LABELS: Required<SiteHeaderLabels> = {
  openMenu: "Abrir menú",
  closeMenu: "Cerrar menú",
  nav: "Principal",
  home: "Inicio",
  submenu: "Mostrar submenú de {label}",
  themeToLight: "Activar modo claro",
  themeToDark: "Activar modo oscuro",
  themeTitle: "Cambiar tema",
};

interface Props {
  brand: BrandConfig;
  links?: NavLink[];
  socials?: SocialLink[];
  mobileMenu?: boolean;
  themeToggle?: boolean;
  labels?: SiteHeaderLabels;
}

const {
  brand,
  links = [],
  socials = [],
  mobileMenu = true,
  themeToggle = true,
  labels: labelOverrides = {},
} = Astro.props;
const labels: Required<SiteHeaderLabels> = { ...DEFAULT_LABELS, ...labelOverrides };

const normalizePath = (p: string) => p.replace(/\/$/, "") || "/";
const path = normalizePath(Astro.url.pathname);
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
/** aria-current for an active link: "page" on an exact match, "true" when
 *  the current page lives under that section. */
const currentAttr = (href: string, active: boolean) =>
  active ? (normalizePath(href) === path ? "page" : "true") : undefined;

const brandHref = brand.href ?? "/";
const brandAria = brand.ariaLabel ?? `${brand.label} — ${labels.home}`;
const brandCurrent = normalizePath(brandHref) === path ? "page" : undefined;

function splitBrandLabel(label: string, em?: string): [string, string, string] {
  if (!em) return [label, "", ""];
  const idx = label.indexOf(em);
  if (idx === -1) return [label, "", ""];
  return [label.slice(0, idx), em, label.slice(idx + em.length)];
}
const [brandPre, brandEm, brandPost] = splitBrandLabel(brand.label, brand.emText);

const hasActions = Astro.slots.has("actions");
const showNav = links.length > 0 || socials.length > 0 || themeToggle || hasActions;
const showMobileToggle = mobileMenu && showNav;
---

<header class="site-header">
  <div class="container header-inner">
    <a href={brandHref} class:list={["brand", { "brand--logo": brand.logoSrc }]} aria-label={brandAria} aria-current={brandCurrent}>
      {brand.logoSrc ? (
        <>
          {/*
            Both variants are decorative: the link already exposes the brand
            name via aria-label, so duplicating it on the visible <img> would
            double-announce in screen readers. We mark both alt="" + aria-hidden
            so toggling the theme (which swaps which <img> is display:none)
            doesn't change the accessible name.
          */}
          <img
            src={brand.logoSrc.dark}
            alt=""
            aria-hidden="true"
            class="brand-logo brand-logo--dark"
            height={brand.logoHeight ?? 28}
          />
          <img
            src={brand.logoSrc.light}
            alt=""
            aria-hidden="true"
            class="brand-logo brand-logo--light"
            height={brand.logoHeight ?? 28}
          />
        </>
      ) : (
        <>
          {brand.mark === "chimi" ? (
            <span class="brand-mark brand-mark--chimi" aria-hidden="true"><BrandMark size={14} /></span>
          ) : brand.mark ? (
            <span class="brand-mark" aria-hidden="true">{brand.mark}</span>
          ) : null}
          <span class="brand-name">
            {brandEm ? (
              <>{brandPre}<em>{brandEm}</em>{brandPost}</>
            ) : (
              brand.label
            )}
          </span>
          {brand.byline && <span class="brand-by">{brand.byline}</span>}
        </>
      )}
    </a>

    {showMobileToggle && (
      <button
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="ds-primary-nav"
        aria-label={labels.openMenu}
        data-label-open={labels.openMenu}
        data-label-close={labels.closeMenu}
      >
        <span></span><span></span><span></span>
      </button>
    )}

    {showNav && (
      <nav
        class:list={["site-nav", { "site-nav--inline": !showMobileToggle }]}
        id="ds-primary-nav"
        aria-label={labels.nav}
      >
        {links.length > 0 && (
          <ul class="nav-list">
            {links.map((l, i) => (
              <li class:list={["nav-item", { "has-children": l.children && l.children.length > 0 }]}>
                {l.children && l.children.length > 0 ? (
                  <>
                    <a
                      href={l.href}
                      class:list={[
                        "nav-link",
                        { active: !l.external && isActive(l.href), cta: l.cta },
                      ]}
                      aria-current={currentAttr(l.href, !l.external && isActive(l.href))}
                    >{l.label}<span class="nav-chevron" aria-hidden="true">▾</span></a>
                    <button
                      type="button"
                      class="nav-submenu-toggle"
                      aria-label={labels.submenu.replace("{label}", l.label)}
                      aria-expanded="false"
                      aria-controls={`ds-primary-nav-sub-${i}`}
                    ><span aria-hidden="true">▾</span></button>
                    <ul class="nav-submenu" id={`ds-primary-nav-sub-${i}`}>
                      {l.children.map((c) => (
                        <li>
                          <a
                            href={c.href}
                            class:list={["nav-sublink", { active: isActive(c.href) }]}
                            aria-current={currentAttr(c.href, isActive(c.href))}
                          >{c.label}</a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    href={l.href}
                    target={l.external ? "_blank" : undefined}
                    rel={l.external ? "noopener" : undefined}
                    class:list={[
                      "nav-link",
                      { active: !l.external && isActive(l.href), cta: l.cta },
                    ]}
                    aria-current={currentAttr(l.href, !l.external && isActive(l.href))}
                  >{l.label}</a>
                )}
              </li>
            ))}
          </ul>
        )}
        {(themeToggle || hasActions) && (
          <div class="nav-theme nav-actions">
            <slot name="actions" />
            {themeToggle && (
              <button
                type="button"
                class="theme-toggle"
                data-theme-toggle
                data-label-to-light={labels.themeToLight}
                data-label-to-dark={labels.themeToDark}
                aria-label={labels.themeToLight}
                title={labels.themeTitle}
              >
                <span class="theme-toggle-icon" data-theme-icon="sun"><ThemeIcons icon="sun" size={18} /></span>
                <span class="theme-toggle-icon" data-theme-icon="moon" hidden><ThemeIcons icon="moon" size={18} /></span>
                <noscript><span class="theme-toggle-noscript">JS</span></noscript>
              </button>
            )}
          </div>
        )}
        {socials.length > 0 && (
          <div class="nav-socials">
            {socials.map((s) => (
              <a
                href={s.href}
                class="social-link"
                target="_blank"
                rel="noopener"
                aria-label={s.label}
              >
                <SocialIcons icon={s.icon} size={s.icon === "twitter" ? 16 : 18} />
              </a>
            ))}
          </div>
        )}
      </nav>
    )}
  </div>
</header>

{showMobileToggle && (
  <script is:inline>
    (function () {
      const btn = document.querySelector(".site-header .nav-toggle");
      const nav = document.getElementById("ds-primary-nav");
      if (!btn || !nav) return;
      const labelOpen = btn.dataset.labelOpen || "Abrir menú";
      const labelClose = btn.dataset.labelClose || "Cerrar menú";
      const desktop = window.matchMedia("(min-width: 1024px)");
      const isOpen = () => btn.getAttribute("aria-expanded") === "true";

      function setOpen(open) {
        btn.setAttribute("aria-expanded", String(open));
        btn.setAttribute("aria-label", open ? labelClose : labelOpen);
        nav.classList.toggle("open", open);
      }

      // The nav follows the button in the DOM, so once it is open (and
      // visible) the next Tab lands on its first link.
      btn.addEventListener("click", () => setOpen(!isOpen()));

      // Escape closes the menu and hands focus back to the toggle.
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape" || !isOpen() || desktop.matches) return;
        setOpen(false);
        btn.focus();
      });

      // Following a link closes the menu (also covers in-page anchors and
      // pages restored from the back/forward cache).
      nav.addEventListener("click", (e) => {
        if (e.target instanceof Element && e.target.closest("a[href]")) setOpen(false);
      });
      window.addEventListener("pageshow", () => setOpen(false));
      desktop.addEventListener("change", () => setOpen(false));

      // Submenu toggles (mobile only — desktop uses :hover/:focus-within).
      // Each chevron button toggles its parent .nav-item.has-children.
      nav.querySelectorAll(".nav-submenu-toggle").forEach((toggle) => {
        toggle.addEventListener("click", (e) => {
          e.preventDefault();
          const item = toggle.closest(".nav-item");
          if (!item) return;
          const open = item.classList.toggle("is-open");
          toggle.setAttribute("aria-expanded", String(open));
        });
      });
    })();
  </script>
)}

<script is:inline>
  // Theme toggle wiring — supports any [data-theme-toggle] button in the document.
  (function () {
    if (typeof window === "undefined") return;

    const STORAGE_KEY = "chimi-theme";
    const buttons = document.querySelectorAll("[data-theme-toggle]");
    if (buttons.length === 0) return;

    function getCurrentTheme() {
      return document.documentElement.getAttribute("data-theme") === "light"
        ? "light"
        : "dark";
    }

    function applyTheme(theme) {
      if (theme === "light") {
        document.documentElement.setAttribute("data-theme", "light");
      } else {
        document.documentElement.removeAttribute("data-theme");
      }
      try {
        localStorage.setItem(STORAGE_KEY, theme);
      } catch (_) {
        /* ignore — privacy mode */
      }
      syncButtons(theme);
      window.dispatchEvent(new CustomEvent("themechange", { detail: { theme } }));
    }

    function syncButtons(theme) {
      buttons.forEach((btn) => {
        const sun = btn.querySelector('[data-theme-icon="sun"]');
        const moon = btn.querySelector('[data-theme-icon="moon"]');
        if (theme === "light") {
          // currently light — offer to switch to dark
          sun?.setAttribute("hidden", "");
          moon?.removeAttribute("hidden");
          btn.setAttribute("aria-label", btn.dataset.labelToDark || "Activar modo oscuro");
        } else {
          sun?.removeAttribute("hidden");
          moon?.setAttribute("hidden", "");
          btn.setAttribute("aria-label", btn.dataset.labelToLight || "Activar modo claro");
        }
      });
    }

    // Sync on mount in case the bootstrap was skipped
    syncButtons(getCurrentTheme());

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        applyTheme(getCurrentTheme() === "light" ? "dark" : "light");
      });
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--chimi-z-header);
    /* Solid surface. Frosted glass (backdrop-filter) is on the anti-patterns
       list: see docs/anti-patterns.md. */
    background: var(--recipe-surface);
    border-bottom: 1px solid var(--hairline);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    padding-block: 16px;
    gap: var(--stack-sm) var(--stack-md);
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--chimi-font-family-display);
    /* Clamp floor handles small phones (≤480) directly — no extra media query
       needed. The previous max-width override that pushed brand-name to 16px
       below 480 collapses naturally into this clamp now that the floor is 16. */
    font-size: clamp(16px, 4.5vw, 22px);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .brand-mark {
    color: var(--recipe-accent-text);
    font-family: var(--chimi-font-family-code);
    font-size: 18px;
  }
  /* Chimi character mark: SVG inherits currentColor from the brand link, so
     it adapts to the active recipe (ivory ink in dark canvas-quiet, charcoal
     ink in light canvas-quiet, etc.). */
  .brand-mark--chimi {
    display: inline-flex;
    align-items: center;
    color: var(--recipe-ink);
    /* SVG keeps its 38:82 aspect; a 22px wide rendering ≈ 47px tall, so we
       scale it slightly to match the brand text height visually. */
  }
  .brand-mark--chimi svg {
    height: 0.75em;
    width: auto;
    display: block;
  }
  /* "Code" in the brand name is identity: it keeps the brand accent, not
     the text-safe --recipe-accent-text. */
  .brand-name em {
    color: var(--recipe-accent);
    font-style: normal;
    padding: 0 4px;
  }
  /*
    `.brand-by` ("by Chimi" tagline) is hidden on phones to keep the brand
    block compact alongside the hamburger; it returns at tablet and up where
    the header has room for the secondary tagline.
  */
  .brand-by {
    display: none;
    font: var(--web-eyebrow);
    letter-spacing: 0.18em;
    color: var(--muted);
    text-transform: uppercase;
  }
  @media (min-width: 768px) {
    .brand-by { display: inline; }
  }

  /* Theme-aware logo: render both, swap via [data-theme] on <html>. */
  .brand--logo { gap: 0; }
  .brand-logo {
    display: block;
    width: auto;
    height: auto;
    max-height: 28px;
  }
  /* Default theme is dark (no attribute). */
  .brand-logo--light { display: none; }
  :root[data-theme="light"] .brand-logo--dark { display: none; }
  :root[data-theme="light"] .brand-logo--light { display: block; }

  /*
    Mobile-first nav:
    - default (mobile, ≤1023): hamburger overlay; nav slides in from the
      header bottom as a vertical list.
    - @media (min-width: 1024px) (≥1024): inline horizontal nav, hover-driven submenus,
      socials/theme separated by hairlines.
    The desktop layout was authored first and inverted — see commit history
    if the nav looks wrong on mobile.
  */
  .site-nav {
    display: flex;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: stretch;
    gap: var(--stack-md);
    padding: var(--stack-md) var(--page-pad);
    background: var(--recipe-surface);
    border-bottom: 1px solid var(--hairline);
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    /* Closed = visibility: hidden, so the links leave the tab order and the
       accessibility tree. The visibility flip waits for the fade-out to
       finish when closing and happens at once when opening. */
    visibility: hidden;
    transition: transform 180ms var(--chimi-ease-standard), opacity 180ms var(--chimi-ease-standard), visibility 0s linear 180ms;
    min-width: 0;
  }
  .site-nav.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transition: transform 180ms var(--chimi-ease-standard), opacity 180ms var(--chimi-ease-standard), visibility 0s linear 0s;
  }
  /* mobileMenu={false}: there is no hamburger, and below 1024px the nav
     stays hidden as it did in 0.8.x (single-page tools keep a compact
     header). It is hidden with `visibility`, so its links are out of the
     tab order too. Without JavaScript the `scripting: none` block below
     shows it in flow. */
  .nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--stack-sm);
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: stretch;
    justify-content: flex-start;
  }
  .nav-link {
    font: var(--web-eyebrow);
    /* On mobile we bump nav-link to 14px for legibility / tap comfort; the
       desktop block resets it to 12px (the eyebrow default). */
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-strong);
    padding: 4px 0;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }
  .nav-link.active {
    color: var(--recipe-ink);
    border-bottom-color: var(--recipe-accent);
  }
  .nav-link:hover { color: var(--recipe-accent-text); }
  /*
    CTA pill — uses --recipe-em as the chrome color. On canvas-quiet/signal
    that's lemon in dark and red in light (recipe handles the swap via
    color.recipe.json's $extensions.chimi.theme.light overrides), so the CTA
    stays legible across both themes without a dedicated [data-theme="light"]
    block.

    Hover fills the pill with em. The label on that fill is whichever of
    surface/ink contrasts more with em in the recipe:
      surface — canvas-quiet/signal dark 11.98:1, light 5.87:1; critical 4.65:1
      ink     — paper (em = patagonia) 6.75:1; cool-fresh (em = ivory) 16.31:1
    (surface on patagonia would be 2.42:1). energy-loud tops out at 4.31:1
    with either role; it needs a dedicated on-em role in the tokens.
  */
  .nav-link.cta {
    color: var(--recipe-em);
    border: 1px solid color-mix(in srgb, var(--recipe-em) 50%, transparent);
    border-radius: var(--chimi-radius-pill);
    padding: 8px 14px;
  }
  .nav-link.cta:hover {
    background: var(--recipe-em);
    color: var(--recipe-surface);
  }
  /* :where() keeps this at the base rule's specificity so a consumer's own
     CTA override still wins. */
  :global(:where([data-recipe="paper"], [data-recipe="cool-fresh"])) .nav-link.cta:hover {
    color: var(--recipe-ink);
  }

  /*
    Submenu — accordion on mobile, floating dropdown on desktop.
    The mobile defaults below are inlined into the parent .nav-item; desktop
    promotes the submenu to a positioned floating panel inside @media (min-width: 1024px).
  */
  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  .nav-chevron {
    /* Mobile uses the dedicated .nav-submenu-toggle button; the inline
       chevron on the link is hidden until desktop. */
    display: none;
    font-size: 9px;
    margin-left: 4px;
    color: var(--muted);
    transition: transform var(--chimi-duration-base) var(--chimi-ease-standard);
  }
  .nav-item.has-children:hover .nav-chevron,
  .nav-item.has-children.is-open .nav-chevron {
    transform: rotate(180deg);
    color: var(--recipe-accent-text);
  }
  .nav-submenu {
    position: static;
    width: 100%;
    margin: 0 0 0 8px;
    padding: 4px 0 4px 12px;
    list-style: none;
    background: transparent;
    border: 0;
    border-left: 2px solid var(--hairline);
    border-radius: 0;
    box-shadow: none;
    display: grid;
    gap: 2px;
    max-height: 0;
    overflow: hidden;
    opacity: 1;
    pointer-events: none;
    transform: none;
    /* Collapsed links stay out of the tab order (see .site-nav). */
    visibility: hidden;
    transition: max-height var(--chimi-duration-slow) var(--chimi-ease-standard), visibility 0s linear var(--chimi-duration-slow);
    z-index: var(--chimi-z-dropdown);
  }
  .nav-item.has-children.is-open .nav-submenu {
    max-height: 500px;
    pointer-events: auto;
    visibility: visible;
    transition: max-height var(--chimi-duration-slow) var(--chimi-ease-standard), visibility 0s linear 0s;
  }
  .nav-item.has-children.is-open .nav-submenu-toggle {
    transform: rotate(180deg);
  }
  .nav-sublink {
    display: block;
    padding: 8px 12px;
    border-radius: var(--chimi-radius-md);
    font: var(--web-meta);
    color: var(--muted-strong);
    transition: background var(--chimi-duration-fast) var(--chimi-ease-standard), color var(--chimi-duration-fast) var(--chimi-ease-standard);
  }
  .nav-sublink:hover,
  .nav-sublink:focus-visible {
    background: color-mix(in srgb, var(--recipe-accent) 12%, transparent);
    color: var(--recipe-accent-text);
  }
  /* Inset ring: the mobile accordion clips anything outside the submenu. */
  .nav-sublink:focus-visible {
    outline: 2px solid var(--recipe-accent-text);
    outline-offset: -2px;
  }
  .nav-sublink.active {
    color: var(--recipe-accent-text);
  }
  /* On mobile, the chevron toggle button opens the submenu; on desktop it is
     hidden and hover/.is-open drives the floating dropdown. */
  .nav-submenu-toggle {
    display: inline-flex;
    margin-left: auto;
    background: transparent;
    border: 0;
    padding: 8px;
    cursor: pointer;
    color: var(--muted-strong);
    /* 44×44 touch target below 1024px (the button is hidden on desktop). */
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
  }

  .nav-socials {
    display: flex;
    gap: 12px;
    padding-left: 0;
    border-left: 0;
    border-top: 1px solid var(--hairline);
    padding-top: var(--stack-sm);
  }
  .social-link {
